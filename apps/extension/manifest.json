{
  "manifest_version": 3,
  "name": "PrescriptionMaker.in - Digital Rx & EMR Companion",
  "version": "1.0.0",
  "description": "Seamlessly draft digital prescriptions, capture patient data directly from any web-based EMR, and print or share Rx on WhatsApp.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "PrescriptionMaker - Quick Rx & EMR Capture",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"]
    }
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "http://localhost:3002/*",
    "http://localhost:3003/*",
    "http://localhost:3004/*",
    "http://localhost:3005/*",
    "http://localhost:5173/*",
    "https://prescriptionmaker.in/*",
    "https://*.prescriptionmaker.in/*",
    "https://*.vercel.app/*"
  ],
  "commands": {
    "toggle-rx-widget": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Toggle PrescriptionMaker Floating Widget"
    }
  }
}
